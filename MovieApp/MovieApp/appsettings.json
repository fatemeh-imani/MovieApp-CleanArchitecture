{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [TraceId={TraceId}] {Message:lj}{NewLine}{Exception}"

        }

      },
        {
          "Name": "File",
          "Args": {
            "path": "Logs/movieapp-.txt",
            "rollingInterval": "Day",
            "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] [TraceId={TraceId}] {Message:lj}{NewLine}{Exception}"

          }
        }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MovieCleanConnection": "Server=.;Database=MovieCleanDB;Trusted_connection=true;TrustServerCertificate=true;"
  },
  "Jwt": {
    "Issuer": "MovieApp",
    "Audience": "MovieApp",
    "SecretKey": "THIS_IS_A_SUPER_SECRET_KEY_WITH_AT_LEAST_32_CHARACTERS",
    "ExpirationInMinutes": 60
  }
}
